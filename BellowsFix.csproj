<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.1.0</Version>
    <AssemblyName>BellowsFix</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)/bellowsfix/</OutputPath>
    <PathMap>$(MSBuildProjectDirectory)=/_/Big-Bellows-Revival</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(VINTAGE_STORY)</GameDirectory>
    <GameDirectory Condition="'$(GameDirectory)' == '' and '$(OS)' == 'Windows_NT'">$(AppData)/Vintagestory</GameDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="source/**/*.cs" />
    <Reference Include="VintagestoryAPI" HintPath="$(GameDirectory)/VintagestoryAPI.dll" Private="false" />
    <Reference Include="VintagestoryLib" HintPath="$(GameDirectory)/VintagestoryLib.dll" Private="false" />
    <Reference Include="VSSurvivalMod" HintPath="$(GameDirectory)/Mods/VSSurvivalMod.dll" Private="false" />
    <Reference Include="VSEssentials" HintPath="$(GameDirectory)/Mods/VSEssentials.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDirectory)/Lib/0Harmony.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameDirectory)/Lib/Newtonsoft.Json.dll" Private="false" />
    <Content Include="resources/modinfo.json" Link="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="resources/assets/**/*" Link="assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckGameDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameDirectory)/VintagestoryAPI.dll')" Text="Set GameDirectory to your Vintage Story 1.22.7 installation, or set the VINTAGE_STORY environment variable." />
    <Error Condition="!Exists('$(GameDirectory)/Mods/VSSurvivalMod.dll')" Text="The Vintage Story survival assembly was not found in GameDirectory." />
    <Error Condition="!Exists('$(GameDirectory)/Mods/VSEssentials.dll')" Text="The Vintage Story essentials assembly was not found in GameDirectory." />
    <Error Condition="!Exists('$(GameDirectory)/Lib/0Harmony.dll')" Text="The Harmony assembly was not found in GameDirectory." />
  </Target>

  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(PackageMod)' == 'true'">
    <MakeDir Directories="Releases" />
    <ZipDirectory SourceDirectory="$(OutputPath)" DestinationFile="Releases/BigBellowsRevival-$(Version).zip" Overwrite="true" />
  </Target>
</Project>
